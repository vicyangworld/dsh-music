{
  "name": "@vicyangorg/dsh-music",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.7.0",
  "private": false,
  "license": "MIT",
  "author": "vicyangworld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicyangworld/dsh-music.git"
  },
  "homepage": "https://github.com/vicyangworld/dsh-music#readme",
  "bugs": {
    "url": "https://github.com/vicyangworld/dsh-music/issues"
  },
  "type": "module",
  "description": "Local music plugin: library playback, lyrics and artist stories, history-based recommendations with downloads, and one-click Spotify liked-songs sync.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "music",
    "music-player",
    "local-music",
    "lyrics",
    "recommendations",
    "spotify-sync"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "host/**/*.js",
    "client/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "docs/DETAIL.md",
    "docs/assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
